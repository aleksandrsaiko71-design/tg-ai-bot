# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Демо-режим без AI-ключа: бесплатный внешний сервис (не для приватных данных).
# Поставьте 0, чтобы отключить и требовать AI_API_KEY.
DEMO_AI=1

# --- Свой AI-провайдер (необязательно) ---
# Если AI_API_KEY пустой, работает демо-режим выше.
AI_API_KEY=

# Вариант 1: OpenAI (платно, качественно)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Вариант 2: OpenRouter (есть бесплатные модели с суффиксом :free)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# Вариант 3: DeepSeek (дешёво, хороший русский)
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# Вариант 4: Google Gemini через OpenAI-совместимый эндпоинт (есть бесплатный лимит)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash

# Необязательные настройки
# AI_CHAT_URL=            # полный URL, если у провайдера нестандартный путь
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=900
# MAX_HISTORY=24
# AI_TIMEOUT=90
# SYSTEM_PROMPT=Ты — дружелюбный собеседник в Telegram.
# LOG_LEVEL=INFO

# --- Режим работы ---
# Локально ничего не задавайте — бот запустится в режиме polling.
# На Render переменная RENDER_EXTERNAL_URL подставляется автоматически,
# и бот сам переключится на webhook (это нужно, чтобы жить без вашего ПК).
# Для другого хостинга укажите публичный адрес вручную:
# WEBHOOK_BASE_URL=https://my-bot.example.com
# PORT=8080
